# Set credentials in your shell or secret manager. Do not commit populated files.
GEMINI_API_KEY=
# Native generateContent endpoint template; must contain {model} if model-dependent.
GEMINI_API_ENDPOINT=
GEMINI_AUTH_MODE=api-key
# Address of your own running H3 video service; no default network destination.
H3_BASE_URL=
# Full chat-completions endpoints for the paper's text-only backends.
# QWEN can point to a locally hosted Qwen3.6-27B service.
DEEPSEEK_API_ENDPOINT=
DEEPSEEK_API_KEY=
QWEN_API_ENDPOINT=
QWEN_API_KEY=
